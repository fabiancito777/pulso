{
  "name": "pulso",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Pulso: entrenamiento, progreso y coach AI. Vite + TypeScript + Preact.",
  "//scripts": "test = suite offline (sin llamadas reales a Gemini); test:net = todo, incluidos smoke/edge/quality; test:quality = solo quality, que habla con la API real. verify usa la pasada offline.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --exclude \"src/features/coach/{smoke,edge,quality}.test.ts\"",
    "test:net": "vitest run",
    "test:quality": "vitest run src/features/coach/quality.test.ts",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "UNLICENSED"
}
